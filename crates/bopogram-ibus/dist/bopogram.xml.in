<?xml version="1.0" encoding="utf-8"?>
<!-- IBus component for Bopogram; the install scripts fill in the program path. -->
<component>
  <name>org.freedesktop.IBus.Bopogram</name>
  <description>Bopogram: context-aware Bopomofo input</description>
  <exec>@EXEC@</exec>
  <version>0.1</version>
  <author>Bopogram</author>
  <license>MIT</license>
  <homepage>https://github.com/aqua0801/bopogram</homepage>
  <textdomain>bopogram</textdomain>
  <engines>
    <engine>
      <name>bopogram</name>
      <language>zh_TW</language>
      <license>MIT</license>
      <author>Bopogram</author>
      <icon></icon>
      <layout>us</layout>
      <longname>Bopogram</longname>
      <description>Context-aware Bopomofo (Dachen layout)</description>
      <rank>0</rank>
      <symbol>注</symbol>
    </engine>
  </engines>
</component>
